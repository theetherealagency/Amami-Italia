{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/wp-content/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/wp-content/(plugins|themes)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/wp-includes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/lounge",
      "destination": "/after-dark/",
      "permanent": true
    },
    {
      "source": "/lounge/",
      "destination": "/after-dark/",
      "permanent": true
    },
    {
      "source": "/reservations",
      "destination": "/reservation/",
      "permanent": true
    },
    {
      "source": "/reservations/",
      "destination": "/reservation/",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/after-dark/",
      "permanent": true
    },
    {
      "source": "/gallery/",
      "destination": "/after-dark/",
      "permanent": true
    },
    {
      "source": "/menu-new/",
      "destination": "/menu/",
      "permanent": true
    },
    {
      "source": "/contact-us-new/",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/dining-experience-new/",
      "destination": "/our-story/",
      "permanent": true
    },
    {
      "source": "/reservation-new/",
      "destination": "/reservation/",
      "permanent": true
    },
    {
      "source": "/author/mandy/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about-us-new/",
      "destination": "/our-story/",
      "permanent": true
    },
    { "source": "/about-us/", "destination": "/our-story/", "permanent": true },
    { "source": "/dining-experience/", "destination": "/our-story/", "permanent": true },
    { "source": "/book-a-table/", "destination": "/reservation/", "permanent": true },
    { "source": "/contact-us/", "destination": "/contact/", "permanent": true },
    { "source": "/visit/", "destination": "/contact/", "permanent": true },
    { "source": "/visit/contact/", "destination": "/contact/", "permanent": true },
    { "source": "/dining-menu/", "destination": "/menu/dining/", "permanent": true },
    { "source": "/food-menu/", "destination": "/menu/dining/", "permanent": true },
    { "source": "/drinks/", "destination": "/menu/after-dark/", "permanent": true },
    { "source": "/lounge-menu/", "destination": "/after-dark/", "permanent": true },
    { "source": "/catering-menu/", "destination": "/catering/", "permanent": true },
    { "source": "/catering-services/", "destination": "/catering/", "permanent": true },
    { "source": "/privacy-policy-2/", "destination": "/legal/privacy/", "permanent": true },
    { "source": "/site-map/", "destination": "/", "permanent": true },
    { "source": "/test/", "destination": "/", "permanent": true },
